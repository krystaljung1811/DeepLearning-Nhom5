# Cấu hình Cổng Dịch Vụ AutoDesk Support (Environment Variables)

# URL gốc của hệ thống (dùng để sinh đường dẫn trong email gửi cho khách hàng)
APP_BASE_URL=http://localhost:8000

# Cấu hình SMTP gửi Email thực tế
# Nếu để trống, hệ thống sẽ kích hoạt chế độ "Chưa cấu hình SMTP" và ghi nhật ký mô phỏng
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=support@autodesk.local

# Khóa bảo mật phiên làm việc
SECRET_KEY=change_this_to_a_secure_random_string_32_chars
